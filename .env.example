# ── Server ────────────────────────────────────────────────────────────
PORT=8000

# Session secret key — signs the login cookie; must be 32+ random characters.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Public base URL — set when behind a Cloudflare Tunnel or reverse proxy
# so GitHub OAuth redirect URIs match your registered callback URL.
# For rover01: https://rover01.funpython.org
# The install script sets this automatically after tunnel provisioning.
BASE_URL=

# ── WiFi setup fallback (wifi-connect-fallback.service) — OPTIONAL ──────
# Only used when the device has no working network on boot: it opens its
# own WiFi network with a captive portal so you can pick the real one from
# your phone. Leave blank to use the defaults (SSID "RoboCar-Setup", open/
# no passphrase). See README → "WiFi setup without a screen".
PORTAL_SSID=
PORTAL_PASSPHRASE=

# ── Camera ────────────────────────────────────────────────────────────
# Fallback MJPEG URL if no local camera (CSI or USB) is detected
CAMERA_STREAM_URL=

# ── Motors ───────────────────────────────────────────────────────────
MOTOR_SPEED_DEFAULT=0.75

# Obstacle avoidance: stop and turn when sonar reads below this (cm)
OBSTACLE_THRESHOLD_CM=20

# Rate limiting: max motor commands/second per client IP (0 = disabled)
MOTOR_RATE_LIMIT=20

# ── Servos ───────────────────────────────────────────────────────────
PAN_SERVO_PIN=12
TILT_SERVO_PIN=13
BUZZER_PIN=18

# ── Cloudflare Tunnel (auto-provisioning) — OPTIONAL ────────────────
# Leave all CF_* values empty to run in local-only mode.
# The rover will be accessible at http://<pi-ip>:8000 on your network.
#
# Fill these in only if you want a permanent public URL
# (e.g. https://rover02.funpython.org) via a Cloudflare Tunnel.
# Used ONLY during first-time provisioning; after that, credentials
# are stored in ~/.cloudflared/ and these values are no longer needed.
#
# RECOMMENDED: use an encrypted credentials file on the boot partition.
#   1. Fill in CF_API_TOKEN / CF_ACCOUNT_ID / CF_ZONE_ID in a local cloudflared.env
#   2. Encrypt it: bash scripts/encrypt_env.sh cloudflared.env
#   3. Copy cloudflared.env.enc (NOT cloudflared.env) to /boot/firmware/
#   4. Set CLOUDFLARED_ENV_PASSPHRASE here so the provision service can decrypt it
#
# If you prefer plain text, place cloudflared.env directly on the boot partition.
#
# Obtain from Cloudflare Dashboard:
#   API Token  → My Profile → API Tokens
#                Permissions: Cloudflare Tunnel:Edit + DNS:Edit
#   Account ID → any domain page, right sidebar
#   Zone ID    → funpython.org page, right sidebar
#
# Passphrase for the encrypted boot-partition credentials file:
CLOUDFLARED_ENV_PASSPHRASE=

CF_API_TOKEN=
CF_ACCOUNT_ID=

# CF_ZONE_ID is optional — if omitted, the provisioning script auto-detects
# the first active domain in your Cloudflare account.
CF_ZONE_ID=

# CF_ZONE_NAME lets you pick a specific domain by name when your account has
# more than one (e.g. CF_ZONE_NAME=mydomain.com). Ignored if CF_ZONE_ID is set.
CF_ZONE_NAME=
