[Unit]
Description=RoboControl Robot Car Server
After=network-online.target cloudflared.service
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/robocontrol
EnvironmentFile=/home/ec2-user/robocontrol/.env
ExecStartPre=/bin/bash -c 'fuser -k 8000/tcp 2>/dev/null || true'
ExecStart=/home/ec2-user/robocontrol/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=robocontrol

[Install]
WantedBy=multi-user.target
