[Unit]
Description=RoboControl WiFi Connect fallback (captive portal WiFi setup)
After=NetworkManager.service dbus.service wifi-provision.service
Wants=NetworkManager.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# PORTAL_SSID / PORTAL_PASSPHRASE in .env override the wrapper script's
# defaults (SSID "RoboCar-Setup", no passphrase) — see .env.example.
EnvironmentFile=-/home/pi/robocontrol/.env
# Runs as root, so it runs a root-owned copy installed by scripts/install.sh,
# not the repo file, which the app's user could edit (security audit 2026-11-15).
ExecStart=/usr/local/sbin/robocontrol-wifi-connect.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wifi-connect-fallback

[Install]
WantedBy=multi-user.target
